{
	"name": "ytpt-gui",
	"private": true,
	"version": "1.0.0",
	"description": "Web GUI for ytpt (YouTube Playlist Tracker).",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"start": "node server/index.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint",
		"gen:api": "npx --yes openapi-typescript@7 ./openapi.json -o src/api/schema.d.ts",
		"sync:api": "node scripts/sync-api.mjs && npm run gen:api"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tabs": "^1.2.1",
		"@tanstack/react-query": "^5.107.1",
		"lucide-react": "^1.73.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^29.1.1",
		"oxlint": "^1.90.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
